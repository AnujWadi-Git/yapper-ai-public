# OpenRouter (LLM + tool calling)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# Voice output is browser SpeechSynthesis only in this build -- no server
# TTS config needed. ElevenLabs and SadTalker are intentionally not part of
# the public product; see README for the reasoning.

# Supabase Postgres, via the Supavisor transaction pooler (port 6543) so it
# works from Render's free tier. Project Settings -> Database -> Connection
# pooling -> Transaction mode in the Supabase dashboard.
DATABASE_URL=postgresql://postgres.your_project_ref:your_db_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Auth: generate with `python3 -c "import secrets; print(secrets.token_hex(32))"`.
# Never reuse this value across environments; rotating it logs out all users.
JWT_SECRET=replace_with_a_random_64_char_hex_string

# Cookie "Secure" flag requires HTTPS -- set false only for local http:// dev.
COOKIE_SECURE=true

# Comma-separated list of origins allowed to make credentialed requests
# (CORS). Must be the actual deployed frontend origin(s), never "*", since
# cookie-based auth requires allow_credentials=True.
ALLOWED_ORIGINS=http://localhost:8000,https://yapper-ai-public.onrender.com
