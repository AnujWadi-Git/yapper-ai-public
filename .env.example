# OpenRouter (LLM + tool calling)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# TTS: "browser" (client-side, default) is the only supported mode in the
# public build. ElevenLabs is disabled here (shared free-tier quota is too
# small for multiple users) -- see README for details.
TTS_PROVIDER=browser
